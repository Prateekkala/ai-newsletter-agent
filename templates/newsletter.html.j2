<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Weekly: {{ issue_date.strftime("%d %B %Y") }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2933;">
<tr><td style="padding:28px 32px 8px 32px;">
<div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#6b7280;">{{ issue_date.strftime("%d %B %Y") }}</div>
<h1 style="margin:6px 0 0 0;font-size:26px;line-height:1.25;">AI Weekly</h1>
</td></tr>
<tr><td style="padding:12px 32px 8px 32px;font-size:16px;line-height:1.6;">{{ intro }}</td></tr>
{% for title, entries in sections %}
<tr><td style="padding:24px 32px 4px 32px;"><h2 style="margin:0;font-size:18px;border-bottom:2px solid #e5e7eb;padding-bottom:6px;">{{ title }}</h2></td></tr>
{% for e in entries %}
<tr><td style="padding:14px 32px 6px 32px;">
<a href="{{ e.item.url }}" style="font-size:17px;font-weight:600;color:#1d4ed8;text-decoration:none;">{{ e.item.title }}</a>
<div style="font-size:12px;color:#6b7280;margin:4px 0 6px 0;">{{ e.item.source }} &middot; {{ e.item.published.strftime("%d %b %Y") }}</div>
<div style="font-size:15px;line-height:1.55;">{{ e.summary }}</div>
{% if e.why_it_matters %}
<div style="font-size:15px;line-height:1.55;margin-top:6px;"><strong>Why it matters:</strong> {{ e.why_it_matters }}</div>
{% endif %}
</td></tr>
{% endfor %}
{% endfor %}
<tr><td style="padding:24px 32px 28px 32px;font-size:12px;line-height:1.5;color:#6b7280;border-top:1px solid #e5e7eb;">
{% if ai_summaries %}
Generated by <a href="https://github.com/Prateekkala/ai-newsletter-agent" style="color:#6b7280;">ai-newsletter-agent</a>. Summaries are AI-generated from the linked articles, so check the original source before relying on a detail.
{% else %}
Generated by <a href="https://github.com/Prateekkala/ai-newsletter-agent" style="color:#6b7280;">ai-newsletter-agent</a>. Entries are short excerpts from each publisher's feed, ranked by simple rules.
{% endif %}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
